{
  "name": "selvaguide-backend",
  "version": "1.0.0",
  "description": "API SelvaGuide - Guias turisticos de la Amazonia",
  "main": "app.js",
  "scripts": {
    "start": "nodemon app.js",
    "db:create": "sequelize-cli db:create --config config/config.cjs",
    "db:drop": "sequelize-cli db:drop --config config/config.cjs",
    "db:migrate": "sequelize-cli db:migrate --config config/config.cjs --migrations-path migrations",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config config/config.cjs --migrations-path migrations",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all --config config/config.cjs --migrations-path migrations",
    "db:migrate:status": "sequelize-cli db:migrate:status --config config/config.cjs --migrations-path migrations",
    "db:seed": "sequelize-cli db:seed:all --config config/config.cjs --migrations-path migrations --seeders-path seeders",
    "db:seed:undo": "sequelize-cli db:seed:undo:all --config config/config.cjs --migrations-path migrations --seeders-path seeders"
  },
  "type": "module",
  "author": "Leo",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "sequelize": "^6.37.3",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "sequelize-cli": "^6.6.2"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true
  }
}
